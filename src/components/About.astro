---
import { Briefcase, GraduationCap, Globe2, Award } from '@lucide/astro';

const highlights = [
  {
    icon: Briefcase,
    label: "Experience",
    value: "14+ Years",
    desc: "Automotive, IoT & Distributed Systems"
  },
  {
    icon: Globe2,
    label: "Global Career",
    value: "4 Countries",
    desc: "Sweden, Germany, Switzerland, China"
  },
  {
    icon: GraduationCap,
    label: "Education",
    value: "M.Sc. RWTH Aachen",
    desc: "Visiting Student at ETH Zürich"
  },
  {
    icon: Award,
    label: "Languages",
    value: "5 Languages",
    desc: "English, Swedish, German, Chinese, Cantonese"
  }
];
---

<section id="about" class="py-20 bg-white border-y border-slate-200/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full border border-sky-100">
        Professional Profile
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-3 tracking-tight">
        Architecting robust vehicle platforms & modern AI systems
      </h2>
      <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed">
        I am a System Architect currently based in Gothenburg, Sweden, leading vehicle energy management architecture and geospatial service distribution at Volvo Group. My career bridges 14+ years of cross-disciplinary engineering across automotive central compute platforms, SOA, AUTOSAR, and cutting-edge agentic AI reasoning workflows for complex defect diagnostics.
      </p>
    </div>

    <!-- Highlight Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {highlights.map((item) => (
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-sky-300 hover:shadow-md transition-all duration-200 group">
          <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-sky-600 mb-4 shadow-sm group-hover:bg-sky-600 group-hover:text-white transition-colors">
            <item.icon class="w-5 h-5" />
          </div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{item.label}</p>
          <p class="text-xl font-bold text-slate-900 mt-1">{item.value}</p>
          <p class="text-xs text-slate-600 mt-1 leading-normal">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
