---
import { Building2, MapPin, Calendar, CheckCircle2 } from '@lucide/astro';

const currentRoles = [
  {
    role: "System Architect",
    company: "Volvo Group",
    location: "Gothenburg, Sweden",
    period: "Sept. 2025 – Present",
    current: true,
    bullets: [
      "Lead end-to-end system architecture for vehicle energy efficiency and guidance solutions across Adaptive and Classic AUTOSAR and Linux platforms.",
      "Define vehicle-level distribution architecture for digital map and geospatial services across platform consumers.",
      "Champion AI-driven engineering modernization, introducing agentic AI workflows to accelerate diagnostics and fault investigation."
    ]
  },
  {
    role: "System Architect",
    company: "Volvo Cars",
    location: "Gothenburg, Sweden",
    period: "2022 – 2025",
    current: false,
    bullets: [
      "Governed system architecture and platform integration for the Central Compute Platform across multi-disciplinary engineering domains.",
      "Directed service interface design and vehicle signal database integration across POSIX-based platform services and domain controller stacks.",
      "Established architecture standards for platform performance, end-to-end timing latency, and safety integrity."
    ]
  },
  {
    role: "System Engineer",
    company: "Volvo Cars",
    location: "Gothenburg, Sweden",
    period: "2018 – 2022",
    current: false,
    bullets: [
      "Drove vehicle system engineering for digital map and geolocation data integration across ADAS and automated driving systems.",
      "Led technical alignment and integration with external ecosystem partners (e.g., Google Android Automotive OS) and in-vehicle domain teams."
    ]
  },
  {
    role: "Software Developer",
    company: "Honeywell",
    location: "Shanghai, China",
    period: "Oct. 2016 – 2018",
    current: false,
    bullets: [
      "Developed client applications and middleware for an enterprise IoT logistics platform; maintained Greater China cloud infrastructure."
    ]
  }
];

const priorRoles = [
  {
    role: "Software Developer",
    company: "Honeywell Movilizer",
    location: "Mannheim, Germany",
    period: "2015 – 2016"
  },
  {
    role: "Research Assistant",
    company: "ETH Zürich (HCI & Software Reliability Labs)",
    location: "Zürich, Switzerland",
    period: "2014"
  },
  {
    role: "Development Intern",
    company: "BMW Group (Vehicle Integration & Validation)",
    location: "Munich, Germany",
    period: "2013"
  },
  {
    role: "Research Assistant",
    company: "Fraunhofer FIT (User-Centered Computing Group)",
    location: "Sankt Augustin, Germany",
    period: "2011 – 2012"
  }
];
---

<section id="experience" class="py-20 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14">
      <span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-3 py-1 rounded-full border border-sky-100">
        Career Journey
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-3 tracking-tight">
        Work Experience
      </h2>
      <p class="text-slate-600 text-base mt-2">
        14+ years of professional engineering leadership across global automotive and research institutions.
      </p>
    </div>

    <!-- Timeline of Key Roles -->
    <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200 space-y-12">
      {currentRoles.map((role) => (
        <div class="relative group">
          <!-- Timeline Node -->
          <div class={`absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-white shadow-sm transition-transform duration-200 group-hover:scale-125 ${
            role.current ? 'bg-sky-600 ring-4 ring-sky-100' : 'bg-slate-400'
          }`} />

          <!-- Card Content -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
              <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>{role.role}</span>
                {role.current && (
                  <span class="inline-flex items-center text-xs px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
                    Current
                  </span>
                )}
              </h3>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
                <Calendar class="w-3.5 h-3.5 text-slate-400" />
                {role.period}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-4 text-sm text-slate-600 mb-4 font-medium">
              <span class="flex items-center gap-1.5 text-sky-700">
                <Building2 class="w-4 h-4" />
                {role.company}
              </span>
              <span class="flex items-center gap-1.5 text-slate-500">
                <MapPin class="w-4 h-4" />
                {role.location}
              </span>
            </div>

            <ul class="space-y-2 text-sm text-slate-700 leading-relaxed">
              {role.bullets.map((b) => (
                <li class="flex items-start gap-2.5">
                  <CheckCircle2 class="w-4 h-4 text-sky-500 mt-1 shrink-0" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Prior Experience (Concise level) -->
    <div class="mt-14 pt-10 border-t border-slate-200">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-4">
        Prior Professional & Academic Experience (2011 – 2016)
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {priorRoles.map((item) => (
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition-colors">
            <span class="text-xs font-semibold text-sky-600">{item.period}</span>
            <p class="font-bold text-slate-900 text-sm mt-1">{item.role}</p>
            <p class="text-xs text-slate-600 font-medium">{item.company}</p>
            <p class="text-xs text-slate-400 mt-1 flex items-center gap-1">
              <MapPin class="w-3 h-3" />
              {item.location}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
