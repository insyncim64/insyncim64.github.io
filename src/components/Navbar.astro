---
import { Mail } from '@lucide/astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="#" class="group flex items-center gap-2.5 font-bold text-slate-900 text-lg tracking-tight hover:text-sky-600 transition-colors">
      <div class="w-8 h-8 rounded-lg bg-sky-600 text-white flex items-center justify-center font-extrabold text-sm shadow-sm group-hover:bg-sky-500 transition-colors">
        JO
      </div>
      <span>Jibin Ou</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
      <a href="#about" class="hover:text-sky-600 transition-colors">About</a>
      <a href="#experience" class="hover:text-sky-600 transition-colors">Experience</a>
      <a href="#projects" class="hover:text-sky-600 transition-colors">Projects</a>
      <a href="#education" class="hover:text-sky-600 transition-colors">Education</a>
      <a href="#skills" class="hover:text-sky-600 transition-colors">Skills</a>
      <a href="#publications" class="hover:text-sky-600 transition-colors">Publications</a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <a
        href="https://de.linkedin.com/in/jibin-ou-830a5421"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-2 text-slate-500 hover:text-[#0077b5] hover:bg-slate-100 rounded-full transition-colors"
      >
        <LinkedinIcon class="w-5 h-5" />
      </a>
      <a
        href="mailto:jibin.ou@outlook.com"
        aria-label="Send Email"
        class="p-2 text-slate-500 hover:text-sky-600 hover:bg-slate-100 rounded-full transition-colors"
      >
        <Mail class="w-5 h-5" />
      </a>
      <a
        href="#contact"
        class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 text-xs font-semibold rounded-full bg-slate-900 text-white hover:bg-sky-600 transition-colors shadow-sm"
      >
        Contact
      </a>
    </div>
  </div>
</header>
